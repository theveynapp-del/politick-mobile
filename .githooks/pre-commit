#!/bin/sh
# Blocks commits that drop integrations the type-checker can't see, or that put
# an opinion in front of a reader.
# See scripts/check-wiring.mjs and scripts/check-neutral-voice.mjs for what's
# guarded and why.
node scripts/check-wiring.mjs || {
  echo ""
  echo "Commit blocked. To bypass in a genuine emergency: git commit --no-verify"
  exit 1
}
node scripts/check-neutral-voice.mjs || {
  echo ""
  echo "Commit blocked. To bypass in a genuine emergency: git commit --no-verify"
  exit 1
}
